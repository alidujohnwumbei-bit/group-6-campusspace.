rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAutoAdminEmail() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@ucc.edu.gh' ||
        request.auth.token.email == 'alidujohnwumbei12@gmail.com' ||
        request.auth.token.email == 'alidujohnwumbel12@gmail.com'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 's88806135@gmail.com' && request.auth.token.email_verified == true) ||
        isAutoAdminEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function isNotDisabled() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.disabled != true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'uccId', 'department', 'role', 'campusRole', 'phone', 'disabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'fullName', 'email', 'uccId', 'department', 'role', 'campusRole', 'phone', 'disabled', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 150
        && data.uccId is string && data.uccId.size() >= 3 && data.uccId.size() <= 32 && data.uccId.matches('^[a-zA-Z0-9/_\\-]+$')
        && data.department is string && data.department.size() >= 2 && data.department.size() <= 100
        && data.role in ['student', 'lecturer', 'admin']
        && data.campusRole in ['Admin', 'Administrator', 'Student', 'Class Representative', 'Lecturer', 'AV Technician', 'Department Coordinator']
        && data.phone is string && data.phone.size() <= 24
        && data.disabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVenue(data) {
      return data.keys().hasAll(['code', 'name', 'building', 'campusZone', 'capacity', 'status', 'blocked', 'maintenanceNote', 'currentCourse', 'currentLecturer', 'timeSlot', 'micStatus', 'micBattery', 'speakerStatus', 'projectorReady', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['code', 'name', 'building', 'campusZone', 'capacity', 'status', 'blocked', 'maintenanceNote', 'currentCourse', 'currentLecturer', 'timeSlot', 'micStatus', 'micBattery', 'speakerStatus', 'projectorReady', 'updatedBy', 'updatedAt'])
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 24
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.building is string && data.building.size() >= 2 && data.building.size() <= 80
        && data.campusZone in ['New Site', 'Old Site', 'Science', 'School of Business', 'Library Complex']
        && data.capacity is int && data.capacity >= 5 && data.capacity <= 2000
        && data.status in ['Available', 'Occupied', 'Reserved', 'Maintenance', 'Emergency']
        && data.blocked is bool
        && data.maintenanceNote is string && data.maintenanceNote.size() <= 200
        && data.currentCourse is string && data.currentCourse.size() <= 120
        && data.currentLecturer is string && data.currentLecturer.size() <= 80
        && data.timeSlot is string && data.timeSlot.size() <= 60
        && data.micStatus in ['Ready', 'Low Battery', 'Charging', 'Faulty', 'None']
        && data.micBattery is int && data.micBattery >= 0 && data.micBattery <= 100
        && data.speakerStatus in ['Operational', 'Muted', 'Faulty', 'Maintenance']
        && data.projectorReady is bool
        && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['roomId', 'roomCode', 'roomName', 'courseCode', 'courseTitle', 'date', 'startTime', 'endTime', 'attendeesCount', 'status', 'requestedBy', 'requestedAt', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'reason', 'cancelledByName', 'ownerId', 'ownerName', 'ownerDepartment', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['roomId', 'roomCode', 'roomName', 'courseCode', 'courseTitle', 'date', 'startTime', 'endTime', 'attendeesCount', 'status', 'requestedBy', 'requesterUid', 'requesterEmail', 'requestedAt', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'reason', 'cancelledByName', 'ownerId', 'ownerName', 'ownerDepartment', 'createdAt', 'updatedAt'])
        && isValidId(data.roomId) && data.roomId.size() <= 64
        && data.roomCode is string && data.roomCode.size() >= 2 && data.roomCode.size() <= 24
        && data.roomName is string && data.roomName.size() >= 2 && data.roomName.size() <= 100
        && data.courseCode is string && data.courseCode.size() >= 2 && data.courseCode.size() <= 24
        && data.courseTitle is string && data.courseTitle.size() >= 2 && data.courseTitle.size() <= 120
        && data.date is string && data.date.size() >= 8 && data.date.size() <= 20
        && data.startTime is string && data.startTime.size() >= 4 && data.startTime.size() <= 10
        && data.endTime is string && data.endTime.size() >= 4 && data.endTime.size() <= 10
        && data.attendeesCount is int && data.attendeesCount >= 1 && data.attendeesCount <= 2000
        && data.status in ['pending', 'approved', 'rejected', 'cancelled']
        && isValidId(data.requestedBy)
        && (!('requesterUid' in data) || isValidId(data.requesterUid))
        && (!('requesterEmail' in data) || (data.requesterEmail is string && data.requesterEmail.size() <= 150))
        && data.requestedAt is timestamp
        && data.reviewedBy is string && data.reviewedBy.size() <= 128
        && data.reviewedByName is string && data.reviewedByName.size() <= 80
        && (data.reviewedAt == null || data.reviewedAt is timestamp)
        && data.reason is string && data.reason.size() <= 240
        && data.cancelledByName is string && data.cancelledByName.size() <= 80
        && isValidId(data.ownerId)
        && data.ownerName is string && data.ownerName.size() >= 2 && data.ownerName.size() <= 80
        && data.ownerDepartment is string && data.ownerDepartment.size() >= 2 && data.ownerDepartment.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVenueSchedule(data) {
      return data.keys().hasAll(['venueId', 'venueCode', 'venueName', 'courseCode', 'courseTitle', 'date', 'startTime', 'endTime', 'status', 'requestedBy', 'updatedAt'])
        && data.keys().hasOnly(['venueId', 'venueCode', 'venueName', 'courseCode', 'courseTitle', 'date', 'startTime', 'endTime', 'status', 'requestedBy', 'updatedAt'])
        && isValidId(data.venueId) && data.venueId.size() <= 64
        && data.venueCode is string && data.venueCode.size() >= 2 && data.venueCode.size() <= 24
        && data.venueName is string && data.venueName.size() >= 2 && data.venueName.size() <= 100
        && data.courseCode is string && data.courseCode.size() >= 2 && data.courseCode.size() <= 24
        && data.courseTitle is string && data.courseTitle.size() >= 2 && data.courseTitle.size() <= 120
        && data.date is string && data.date.size() >= 8 && data.date.size() <= 20
        && data.startTime is string && data.startTime.size() >= 4 && data.startTime.size() <= 10
        && data.endTime is string && data.endTime.size() >= 4 && data.endTime.size() <= 10
        && data.status in ['approved', 'cancelled']
        && isValidId(data.requestedBy)
        && data.updatedAt is timestamp;
    }

    function isValidEmergency(data) {
      return data.keys().hasAll(['roomId', 'roomCode', 'issueType', 'urgency', 'description', 'standbyRoomCode', 'status', 'ownerId', 'ownerName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['roomId', 'roomCode', 'issueType', 'urgency', 'description', 'standbyRoomCode', 'status', 'ownerId', 'ownerName', 'createdAt', 'updatedAt'])
        && isValidId(data.roomId) && data.roomId.size() <= 64
        && data.roomCode is string && data.roomCode.size() >= 2 && data.roomCode.size() <= 24
        && data.issueType in ['Microphone / Audio Failure', 'Projector / Power Outage', 'Lecturer Relocation', 'Room Conflict', 'Emergency Standby']
        && data.urgency in ['Critical', 'High', 'Standard']
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 400
        && data.standbyRoomCode is string && data.standbyRoomCode.size() <= 24
        && data.status in ['Open', 'Dispatched', 'Resolved']
        && isValidId(data.ownerId)
        && data.ownerName is string && data.ownerName.size() >= 2 && data.ownerName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAvLog(data) {
      return data.keys().hasAll(['roomId', 'roomCode', 'gearType', 'action', 'batteryAfter', 'ownerId', 'ownerName', 'createdAt'])
        && data.keys().hasOnly(['roomId', 'roomCode', 'gearType', 'action', 'batteryAfter', 'ownerId', 'ownerName', 'createdAt'])
        && isValidId(data.roomId) && data.roomId.size() <= 64
        && data.roomCode is string && data.roomCode.size() >= 2 && data.roomCode.size() <= 24
        && data.gearType in ['Microphone', 'Speaker', 'Soundbar']
        && data.action is string && data.action.size() >= 3 && data.action.size() <= 120
        && data.batteryAfter is int && data.batteryAfter >= 0 && data.batteryAfter <= 100
        && isValidId(data.ownerId)
        && data.ownerName is string && data.ownerName.size() >= 2 && data.ownerName.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll(['action', 'target', 'details', 'actorId', 'actorName', 'actorRole', 'createdAt'])
        && data.keys().hasOnly(['action', 'target', 'details', 'actorId', 'actorName', 'actorRole', 'createdAt'])
        && data.action is string && data.action.size() >= 2 && data.action.size() <= 80
        && data.target is string && data.target.size() >= 1 && data.target.size() <= 120
        && data.details is string && data.details.size() <= 280
        && isValidId(data.actorId)
        && data.actorName is string && data.actorName.size() >= 2 && data.actorName.size() <= 80
        && data.actorRole in ['student', 'lecturer', 'admin']
        && data.createdAt is timestamp;
    }

    // Admins registry (never client-writable)
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    // Users collection: read if owner or admin; auto-admin allowed for designated admin emails
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().disabled == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          incoming().role == 'student' ||
          incoming().role == 'lecturer' ||
          (incoming().role == 'admin' && isAutoAdminEmail())
        );
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'uccId', 'department', 'role', 'campusRole', 'phone', 'disabled', 'updatedAt'])) ||
          (isOwner(userId) && incoming().role == existing().role && incoming().disabled == existing().disabled && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'uccId', 'department', 'campusRole', 'phone', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Venues collection: all signed-in users can read, ONLY admin can write
    match /venues/{venueId} {
      allow get: if isSignedIn() && isValidId(venueId);
      allow list: if isSignedIn() && resource.data.status in ['Available', 'Occupied', 'Reserved', 'Maintenance', 'Emergency'];
      allow create: if isAdmin()
        && isValidId(venueId)
        && isValidVenue(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(venueId)
        && isValidVenue(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(venueId);
    }

    // Public sanitized approved schedule slots for campus availability calendar
    match /venueSchedules/{scheduleId} {
      allow get: if isSignedIn() && isValidId(scheduleId);
      allow list: if isSignedIn() && resource.data.status in ['approved', 'cancelled'];
      allow create: if isAdmin()
        && isValidId(scheduleId)
        && isValidVenueSchedule(incoming())
        && incoming().status == 'approved'
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(scheduleId)
        && isValidVenueSchedule(incoming())
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().requestedBy == request.auth.uid &&
            incoming().status == 'cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(scheduleId);
    }

    // Bookings: any authenticated user can read all bookings and create pending bookings;
    // users can cancel own bookings; only admin can approve/reject/force-cancel or delete.
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && isValidId(bookingId);
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && isNotDisabled()
        && isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().status == 'pending'
        && incoming().requestedBy == request.auth.uid
        && incoming().ownerId == request.auth.uid
        && (!('requesterUid' in incoming()) || incoming().requesterUid == request.auth.uid)
        && incoming().reviewedBy == ''
        && incoming().reviewedByName == ''
        && incoming().reviewedAt == null
        && incoming().reason == ''
        && incoming().cancelledByName == ''
        && incoming().requestedAt == request.time
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().requestedBy == existing().requestedBy
        && incoming().ownerId == existing().ownerId
        && incoming().roomId == existing().roomId
        && incoming().requestedAt == existing().requestedAt
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isAdmin() &&
            incoming().status in ['approved', 'rejected', 'cancelled'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'reason', 'cancelledByName', 'updatedAt'])
          ) ||
          (
            isNotDisabled() &&
            existing().requestedBy == request.auth.uid &&
            existing().status in ['pending', 'approved'] &&
            incoming().status == 'cancelled' &&
            incoming().reviewedBy == existing().reviewedBy &&
            incoming().reviewedByName == existing().reviewedByName &&
            incoming().reviewedAt == existing().reviewedAt &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reason', 'cancelledByName', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(bookingId);
    }

    // Additional operational collections: any authenticated user can create & read; admin approves/deletes
    match /venueRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isNotDisabled() && isValidId(requestId)
        && incoming().status == 'pending';
      allow update: if isAdmin() && isValidId(requestId);
      allow delete: if isAdmin() && isValidId(requestId);
    }

    match /emergencyDispatch/{dispatchId} {
      allow get: if isSignedIn() && isValidId(dispatchId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isNotDisabled() && isValidId(dispatchId);
      allow update: if isAdmin() && isValidId(dispatchId);
      allow delete: if isAdmin() && isValidId(dispatchId);
    }

    match /incidents/{incidentId} {
      allow get: if isSignedIn() && isValidId(incidentId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isNotDisabled() && isValidId(incidentId);
      allow update: if isAdmin() && isValidId(incidentId);
      allow delete: if isAdmin() && isValidId(incidentId);
    }

    // Emergency Classroom & AV Dispatches
    match /emergencies/{emergencyId} {
      allow get: if isSignedIn() && isValidId(emergencyId);
      allow list: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.status in ['Open', 'Dispatched', 'Resolved']
      );
      allow create: if isSignedIn()
        && isNotDisabled()
        && isValidId(emergencyId)
        && isValidEmergency(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(emergencyId)
        && isValidEmergency(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().roomId == existing().roomId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().status != 'Resolved' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'standbyRoomCode', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(emergencyId);
    }

    // Immutable AV Maintenance Logs
    match /avLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId);
      allow list: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.gearType in ['Microphone', 'Speaker', 'Soundbar']
      );
      allow create: if isSignedIn()
        && isNotDisabled()
        && isValidId(logId)
        && isValidAvLog(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // System Activity Logs (Admin readable, authenticated append-only)
    match /activityLogs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(logId)
        && isValidActivityLog(incoming())
        && incoming().actorId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
