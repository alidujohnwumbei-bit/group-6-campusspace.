rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened helpers
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 's88806135@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'uccId', 'department', 'campusRole', 'phone', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'fullName', 'email', 'uccId', 'department', 'campusRole', 'phone', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 150
        && data.uccId is string && data.uccId.size() >= 3 && data.uccId.size() <= 32 && data.uccId.matches('^[a-zA-Z0-9/_\\-]+$')
        && data.department is string && data.department.size() >= 2 && data.department.size() <= 100
        && data.campusRole in ['Lecturer', 'Class Representative', 'AV Technician', 'Department Coordinator', 'Student']
        && data.phone is string && data.phone.size() <= 24
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRoom(data) {
      return data.keys().hasAll(['code', 'name', 'building', 'campusZone', 'capacity', 'status', 'currentCourse', 'currentLecturer', 'timeSlot', 'micStatus', 'micBattery', 'speakerStatus', 'projectorReady', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['code', 'name', 'building', 'campusZone', 'capacity', 'status', 'currentCourse', 'currentLecturer', 'timeSlot', 'micStatus', 'micBattery', 'speakerStatus', 'projectorReady', 'updatedBy', 'updatedAt'])
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 24
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.building is string && data.building.size() >= 2 && data.building.size() <= 80
        && data.campusZone in ['New Site', 'Old Site', 'Science', 'School of Business', 'Library Complex']
        && data.capacity is int && data.capacity >= 5 && data.capacity <= 2000
        && data.status in ['Available', 'Occupied', 'Reserved', 'Cancelled', 'Emergency']
        && data.currentCourse is string && data.currentCourse.size() <= 120
        && data.currentLecturer is string && data.currentLecturer.size() <= 80
        && data.timeSlot is string && data.timeSlot.size() <= 60
        && data.micStatus in ['Ready', 'Low Battery', 'Charging', 'Faulty', 'None']
        && data.micBattery is int && data.micBattery >= 0 && data.micBattery <= 100
        && data.speakerStatus in ['Operational', 'Muted', 'Faulty', 'Maintenance']
        && data.projectorReady is bool
        && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['roomId', 'roomCode', 'roomName', 'courseCode', 'courseTitle', 'date', 'startTime', 'endTime', 'attendeesCount', 'status', 'cancellationReason', 'cancelledByName', 'ownerId', 'ownerName', 'ownerDepartment', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['roomId', 'roomCode', 'roomName', 'courseCode', 'courseTitle', 'date', 'startTime', 'endTime', 'attendeesCount', 'status', 'cancellationReason', 'cancelledByName', 'ownerId', 'ownerName', 'ownerDepartment', 'createdAt', 'updatedAt'])
        && isValidId(data.roomId) && data.roomId.size() <= 64
        && data.roomCode is string && data.roomCode.size() >= 2 && data.roomCode.size() <= 24
        && data.roomName is string && data.roomName.size() >= 2 && data.roomName.size() <= 100
        && data.courseCode is string && data.courseCode.size() >= 2 && data.courseCode.size() <= 24
        && data.courseTitle is string && data.courseTitle.size() >= 2 && data.courseTitle.size() <= 120
        && data.date is string && data.date.size() >= 8 && data.date.size() <= 20
        && data.startTime is string && data.startTime.size() >= 4 && data.startTime.size() <= 10
        && data.endTime is string && data.endTime.size() >= 4 && data.endTime.size() <= 10
        && data.attendeesCount is int && data.attendeesCount >= 1 && data.attendeesCount <= 2000
        && data.status in ['Reserved', 'Occupied', 'Cancelled', 'Completed']
        && data.cancellationReason is string && data.cancellationReason.size() <= 240
        && data.cancelledByName is string && data.cancelledByName.size() <= 80
        && isValidId(data.ownerId)
        && data.ownerName is string && data.ownerName.size() >= 2 && data.ownerName.size() <= 80
        && data.ownerDepartment is string && data.ownerDepartment.size() >= 2 && data.ownerDepartment.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEmergency(data) {
      return data.keys().hasAll(['roomId', 'roomCode', 'issueType', 'urgency', 'description', 'standbyRoomCode', 'status', 'ownerId', 'ownerName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['roomId', 'roomCode', 'issueType', 'urgency', 'description', 'standbyRoomCode', 'status', 'ownerId', 'ownerName', 'createdAt', 'updatedAt'])
        && isValidId(data.roomId) && data.roomId.size() <= 64
        && data.roomCode is string && data.roomCode.size() >= 2 && data.roomCode.size() <= 24
        && data.issueType in ['Microphone / Audio Failure', 'Projector / Power Outage', 'Lecturer Relocation', 'Room Conflict', 'Emergency Standby']
        && data.urgency in ['Critical', 'High', 'Standard']
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 400
        && data.standbyRoomCode is string && data.standbyRoomCode.size() <= 24
        && data.status in ['Open', 'Dispatched', 'Resolved']
        && isValidId(data.ownerId)
        && data.ownerName is string && data.ownerName.size() >= 2 && data.ownerName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAvLog(data) {
      return data.keys().hasAll(['roomId', 'roomCode', 'gearType', 'action', 'batteryAfter', 'ownerId', 'ownerName', 'createdAt'])
        && data.keys().hasOnly(['roomId', 'roomCode', 'gearType', 'action', 'batteryAfter', 'ownerId', 'ownerName', 'createdAt'])
        && isValidId(data.roomId) && data.roomId.size() <= 64
        && data.roomCode is string && data.roomCode.size() >= 2 && data.roomCode.size() <= 24
        && data.gearType in ['Microphone', 'Speaker', 'Soundbar']
        && data.action is string && data.action.size() >= 3 && data.action.size() <= 120
        && data.batteryAfter is int && data.batteryAfter >= 0 && data.batteryAfter <= 100
        && isValidId(data.ownerId)
        && data.ownerName is string && data.ownerName.size() >= 2 && data.ownerName.size() <= 80
        && data.createdAt is timestamp;
    }

    // Admins registry (never client-writable)
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    // Users collection (Strict PII isolation)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && (isOwner(userId) || isAdmin())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'uccId', 'department', 'campusRole', 'phone', 'updatedAt'])
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Classrooms & AV readiness
    match /rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId);
      allow list: if isSignedIn() && resource.data.status in ['Available', 'Occupied', 'Reserved', 'Cancelled', 'Emergency'];
      allow create: if isSignedIn()
        && isValidId(roomId)
        && isValidRoom(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(roomId)
        && isValidRoom(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            incoming().code == existing().code &&
            incoming().name == existing().name &&
            incoming().building == existing().building &&
            incoming().campusZone == existing().campusZone &&
            incoming().capacity == existing().capacity &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'currentCourse', 'currentLecturer', 'timeSlot',
              'micStatus', 'micBattery', 'speakerStatus', 'projectorReady',
              'updatedBy', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(roomId);
    }

    // Bookings & Cancellations
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && isValidId(bookingId);
      allow list: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.status in ['Reserved', 'Occupied', 'Cancelled', 'Completed']
      );
      allow create: if isSignedIn()
        && isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/rooms/$(incoming().roomId));
      allow update: if isSignedIn()
        && isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().roomId == existing().roomId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().status != 'Cancelled' &&
            existing().status != 'Completed' &&
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancellationReason', 'cancelledByName', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(bookingId);
    }

    // Emergency Classroom & AV Dispatches
    match /emergencies/{emergencyId} {
      allow get: if isSignedIn() && isValidId(emergencyId);
      allow list: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.status in ['Open', 'Dispatched', 'Resolved']
      );
      allow create: if isSignedIn()
        && isValidId(emergencyId)
        && isValidEmergency(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/rooms/$(incoming().roomId));
      allow update: if isSignedIn()
        && isValidId(emergencyId)
        && isValidEmergency(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().roomId == existing().roomId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().status != 'Resolved' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'standbyRoomCode', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(emergencyId);
    }

    // Immutable AV Maintenance Logs
    match /avLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId);
      allow list: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.gearType in ['Microphone', 'Speaker', 'Soundbar']
      );
      allow create: if isSignedIn()
        && isValidId(logId)
        && isValidAvLog(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/rooms/$(incoming().roomId));
      allow update, delete: if false;
    }
  }
}
