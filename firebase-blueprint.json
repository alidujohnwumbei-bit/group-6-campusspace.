{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Authenticated UCC CampusSpace member profile containing university identity, system role, and account status.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 150
        },
        "uccId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9/_\\-]+$"
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["student", "lecturer", "admin"]
        },
        "campusRole": {
          "type": "string",
          "enum": ["Admin", "Administrator", "Student", "Class Representative", "Lecturer", "AV Technician", "Department Coordinator"]
        },
        "phone": {
          "type": "string",
          "maxLength": 24
        },
        "disabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "fullName", "email", "uccId", "department", "role", "campusRole", "phone", "disabled", "createdAt", "updatedAt"]
    },
    "Venue": {
      "title": "Venue & Lecture Theatre",
      "description": "University of Cape Coast classroom, lecture theatre, or lab managed by administrators.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "building": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "campusZone": {
          "type": "string",
          "enum": ["New Site", "Old Site", "Science", "School of Business", "Library Complex"]
        },
        "capacity": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["Available", "Occupied", "Reserved", "Maintenance", "Emergency"]
        },
        "blocked": {
          "type": "boolean"
        },
        "maintenanceNote": {
          "type": "string",
          "maxLength": 200
        },
        "currentCourse": {
          "type": "string",
          "maxLength": 120
        },
        "currentLecturer": {
          "type": "string",
          "maxLength": 80
        },
        "timeSlot": {
          "type": "string",
          "maxLength": 60
        },
        "micStatus": {
          "type": "string",
          "enum": ["Ready", "Low Battery", "Charging", "Faulty", "None"]
        },
        "micBattery": {
          "type": "integer"
        },
        "speakerStatus": {
          "type": "string",
          "enum": ["Operational", "Muted", "Faulty", "Maintenance"]
        },
        "projectorReady": {
          "type": "boolean"
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["code", "name", "building", "campusZone", "capacity", "status", "blocked", "maintenanceNote", "currentCourse", "currentLecturer", "timeSlot", "micStatus", "micBattery", "speakerStatus", "projectorReady", "updatedBy", "updatedAt"]
    },
    "Booking": {
      "title": "Venue Booking Request",
      "description": "Classroom booking request requiring administrator approval, with full audit fields.",
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roomCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24
        },
        "roomName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "courseCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24
        },
        "courseTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "date": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        },
        "startTime": {
          "type": "string",
          "minLength": 4,
          "maxLength": 10
        },
        "endTime": {
          "type": "string",
          "minLength": 4,
          "maxLength": 10
        },
        "attendeesCount": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "cancelled"]
        },
        "requestedBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "requestedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reviewedBy": {
          "type": "string",
          "maxLength": 128
        },
        "reviewedByName": {
          "type": "string",
          "maxLength": 80
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "maxLength": 240
        },
        "cancelledByName": {
          "type": "string",
          "maxLength": 80
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "ownerDepartment": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["roomId", "roomCode", "roomName", "courseCode", "courseTitle", "date", "startTime", "endTime", "attendeesCount", "status", "requestedBy", "requestedAt", "reviewedBy", "reviewedByName", "reason", "cancelledByName", "ownerId", "ownerName", "ownerDepartment", "createdAt", "updatedAt"]
    },
    "VenueSchedule": {
      "title": "Public Approved Venue Schedule",
      "description": "Sanitized approved venue booking slots for campus availability calendar display without user PII.",
      "type": "object",
      "properties": {
        "venueId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "venueCode": {
          "type": "string",
          "maxLength": 24
        },
        "venueName": {
          "type": "string",
          "maxLength": 100
        },
        "courseCode": {
          "type": "string",
          "maxLength": 24
        },
        "courseTitle": {
          "type": "string",
          "maxLength": 120
        },
        "date": {
          "type": "string",
          "maxLength": 20
        },
        "startTime": {
          "type": "string",
          "maxLength": 10
        },
        "endTime": {
          "type": "string",
          "maxLength": 10
        },
        "status": {
          "type": "string",
          "enum": ["approved", "cancelled"]
        },
        "requestedBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["venueId", "venueCode", "venueName", "courseCode", "courseTitle", "date", "startTime", "endTime", "status", "requestedBy", "updatedAt"]
    },
    "EmergencyRequest": {
      "title": "Emergency Classroom & AV Dispatch",
      "description": "Emergency classroom relocation request or critical AV hardware dispatch ticket.",
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roomCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24
        },
        "issueType": {
          "type": "string",
          "enum": ["Microphone / Audio Failure", "Projector / Power Outage", "Lecturer Relocation", "Room Conflict", "Emergency Standby"]
        },
        "urgency": {
          "type": "string",
          "enum": ["Critical", "High", "Standard"]
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 400
        },
        "standbyRoomCode": {
          "type": "string",
          "maxLength": 24
        },
        "status": {
          "type": "string",
          "enum": ["Open", "Dispatched", "Resolved"]
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["roomId", "roomCode", "issueType", "urgency", "description", "standbyRoomCode", "status", "ownerId", "ownerName", "createdAt", "updatedAt"]
    },
    "AvLog": {
      "title": "AV Readiness Log",
      "description": "Immutable maintenance log for microphone battery swaps and speaker diagnostic tests.",
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roomCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24
        },
        "gearType": {
          "type": "string",
          "enum": ["Microphone", "Speaker", "Soundbar"]
        },
        "action": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "batteryAfter": {
          "type": "integer"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["roomId", "roomCode", "gearType", "action", "batteryAfter", "ownerId", "ownerName", "createdAt"]
    },
    "ActivityLog": {
      "title": "System Activity Log",
      "description": "Audit log tracking booking submissions, approvals, rejections, cancellations, and admin changes.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "details": {
          "type": "string",
          "maxLength": 280
        },
        "actorId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "actorRole": {
          "type": "string",
          "enum": ["student", "lecturer", "admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["action", "target", "details", "actorId", "actorName", "actorRole", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User account profile with role (student/lecturer/admin) and disabled flag."
    },
    "/venues/{venueId}": {
      "schema": { "$ref": "#/entities/Venue" },
      "description": "UCC campus venues, classrooms, and AV readiness state (admin-writable)."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Venue booking requests with approval/rejection workflow."
    },
    "/venueSchedules/{scheduleId}": {
      "schema": { "$ref": "#/entities/VenueSchedule" },
      "description": "Public approved venue slots for campus availability calendar."
    },
    "/emergencies/{emergencyId}": {
      "schema": { "$ref": "#/entities/EmergencyRequest" },
      "description": "Emergency classroom relocation and AV hardware dispatch tickets."
    },
    "/avLogs/{logId}": {
      "schema": { "$ref": "#/entities/AvLog" },
      "description": "Immutable audio gear maintenance and battery swap logs."
    },
    "/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Immutable audit log of bookings, reviews, and venue/user management actions."
    }
  }
}
